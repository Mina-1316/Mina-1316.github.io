---
import { getDefaultNavMenus } from "#components/organisms/navbar";
import { getContentKey } from "#lib/path";
import type { GetStaticPaths } from "astro";
import { getCollection, getEntries, getEntry, render } from "astro:content";
import DefaultLayout from "~/layouts/default-layout.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("post");
  return posts.flatMap((post) => {
    if (post.filePath === undefined) return [];
    const postId = getContentKey(post.filePath);
    return {
      params: { postid: postId },
      props: { post },
    };
  });
}) satisfies GetStaticPaths;

const { post } = Astro.props;

const { Content, remarkPluginFrontmatter } = await render(post);
const menus = getDefaultNavMenus();
---

<DefaultLayout title={post.data.title} menus={menus}>
  <div>
    <h1>{post.data.title}</h1>
    <Content />
  </div>
</DefaultLayout>
