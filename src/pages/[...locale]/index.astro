---
import { getDefaultNavMenus, type NavMenu } from "#components/organisms/navbar";
import { DEFAULT_LOCALE } from "#lib/locale";
import { getPrefix, localeMap } from "intlayer";
import { getIntlayer, getLocaleFromPath } from "intlayer";
import DefaultLayout from "~/layouts/default-layout.astro";

export const getStaticPaths = () =>
  localeMap(({ locale }) => ({
    params: { locale: getPrefix(locale).localePrefix },
  }));

const locale = getLocaleFromPath(Astro.params.locale) ?? DEFAULT_LOCALE;
const menus = getDefaultNavMenus(locale);

const { text } = getIntlayer("index", locale);
---

<DefaultLayout title="Home" menus={menus} locale={locale}>
  {text}
</DefaultLayout>
